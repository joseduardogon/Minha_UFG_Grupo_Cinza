@startuml DCdu-AppsUFG-01
title DCdu-AppsUFG-01 – Casos de uso de Apps UFG
left to right direction
skinparam packageStyle rectangle

actor "Membro da comunidade UFG" as Membro
actor "Aplicativo externo" as AppExt <<sistema>>
actor "Play Store" as PlayStore <<sistema>>
PlayStore -up-|> AppExt

rectangle "App Minha UFG – Apps UFG" {
  usecase "UC08.1\nVisualizar catálogo\nde apps UFG" as UC081
  usecase "UC08.2\nAbrir aplicativo\nna Play Store" as UC082
}

Membro --> UC081
Membro --> UC082

UC082 ..> UC081 : <<extend>>
UC082 --> PlayStore
@enduml

