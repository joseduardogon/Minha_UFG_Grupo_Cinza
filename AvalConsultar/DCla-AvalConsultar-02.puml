@startuml DCla-AvalConsultar-02
title DCla-AvalConsultar-02 – Classes dos componentes FonteNotasUFG, FonteNotasArea e FonteNotasUnidade
hide empty members

package "Comum" {
  interface "IFonteDados<T>" as IFonteDados <<Comum>> {
    + carregar(): List<T>
  }
  interface IAcessoApi <<Comum>> {
    + obter(caminho: String, parametros: Map<String, String>): RespostaApi
  }
  class ErroApi <<Comum>>
}

package "Locais" {
  class UnidadeAcademica <<Locais>>
  class AreaConhecimento <<Locais>>
}

package "AvalRegistrar" {
  class DimensaoQualidade <<AvalRegistrar>>
}

class FonteNotasUFG {
  - acesso: IAcessoApi
  - notaUfg: Real [0..1]
  + FonteNotasUFG(acesso: IAcessoApi)
  + carregar(): List<MediaArea>
  + obterNotaUfg(): Real [0..1]
  - converter(corpo: String): List<MediaArea>
}

class FonteNotasArea {
  - acesso: IAcessoApi
  - areaConhecimento: AreaConhecimento
  - mediaArea: Real [0..1]
  + FonteNotasArea(acesso: IAcessoApi, areaConhecimento: AreaConhecimento)
  + carregar(): List<NotaUnidade>
  + obterMediaArea(): Real [0..1]
  - converter(corpo: String): List<NotaUnidade>
}

class FonteNotasUnidade {
  - acesso: IAcessoApi
  - unidade: UnidadeAcademica
  - notaUnidade: Real [0..1]
  + FonteNotasUnidade(acesso: IAcessoApi, unidade: UnidadeAcademica)
  + carregar(): List<NotaDimensao>
  + obterNotaUnidade(): Real [0..1]
  - converter(corpo: String): List<NotaDimensao>
}

class MediaArea {
  + nota: Real [0..1]
}

class NotaUnidade {
  + nota: Real [0..1]
}

class NotaDimensao {
  + nota: Real
}

IFonteDados <|.. FonteNotasUFG
IFonteDados <|.. FonteNotasArea
IFonteDados <|.. FonteNotasUnidade
FonteNotasUFG ..> MediaArea : <<create>>
FonteNotasArea ..> NotaUnidade : <<create>>
FonteNotasUnidade ..> NotaDimensao : <<create>>
FonteNotasUFG ..> ErroApi : <<throws>>
FonteNotasArea ..> ErroApi : <<throws>>
FonteNotasUnidade ..> ErroApi : <<throws>>

MediaArea "0..*" --> "1" AreaConhecimento : areaConhecimento
FonteNotasArea --> "1" AreaConhecimento : areaConhecimento
NotaUnidade "0..*" --> "1" UnidadeAcademica : unidade
NotaDimensao "0..*" --> "1" DimensaoQualidade : dimensao
@enduml
