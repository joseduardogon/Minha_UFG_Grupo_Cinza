@startuml DCdu-AvalRegistrar-01
title DCdu-AvalRegistrar-01 – Casos de uso de Avaliação de UA (registrar)
left to right direction
skinparam packageStyle rectangle

actor "Membro da comunidade UFG" as Membro
actor "Avaliador\n(anônimo)" as Avaliador
Avaliador -up-|> Membro
actor "Servidor/API" as API <<sistema>>

rectangle "App Minha UFG – Avaliação de UA (registrar)" {
  usecase "UC09.1\nEscolher a unidade\nacadêmica a avaliar" as UC091
  usecase "UC09.2\nResponder o questionário\nde qualidade" as UC092
  usecase "UC09.3\nEnviar a avaliação" as UC093
  usecase "UC09.4\nValidar o\npreenchimento" as UC094
}

Avaliador --> UC091
Avaliador --> UC092
Avaliador --> UC093
UC093 ..> UC094 : <<include>>

UC091 --> API
UC092 --> API
UC093 --> API
@enduml
