@startuml DCla-AvalRegistrar-01
title DCla-AvalRegistrar-01 – Classes do componente TelasAvaliacao
hide empty members
left to right direction
skinparam nodesep 30
skinparam ranksep 60

package "Comum" {
  interface IAcessoApi <<Comum>> {
    + obter(caminho: String, parametros: Map<String, String>): RespostaApi
    + enviar(caminho: String, corpo: String): RespostaApi
  }
  interface "IControladorTelaRemota<T>" as IControlador <<Comum>> {
    + aoEntrarNaTela(): void
    + recarregar(): void
    + obterEstado(): EstadoTela
    + obterDados(): List<T>
    + registrarObservador(o: IObservadorEstado): void
  }
  class "ControladorTelaRemota<T>" as Controlador <<Comum>>
  interface IObservadorEstado <<Comum>> {
    + aoMudarEstado(estado: EstadoTela): void
  }
  enum EstadoTela <<Comum>>
}

package "Locais" {
  class UnidadeAcademica <<Locais>>
}

package "AvalConsultar" {
  class "Tela de AvalConsultar" as TelaConsulta <<AvalConsultar>>
}

package "Outros componentes de AvalRegistrar" {
  class FonteUnidades <<DCla-AvalRegistrar-02>>
  class FonteQuestionario <<DCla-AvalRegistrar-03>>
  class DimensaoQualidade <<DCla-AvalRegistrar-03>>
  class Questao <<DCla-AvalRegistrar-03>>
  class ServicoEnvioAvaliacao <<DCla-AvalRegistrar-04>>
  class Avaliacao <<DCla-AvalRegistrar-04>>
  enum ResultadoEnvio <<DCla-AvalRegistrar-04>>
}

class TelaAvaliacao {
  + TelaAvaliacao(acesso: IAcessoApi)
  + aoExibir(): void
  + aoTocarAvaliar(): void
  + aoTocarConsultar(): void
  + aoVoltar(): void
}

class TelaEscolherUA {
  - acesso: IAcessoApi
  - controlador: IControladorTelaRemota<UnidadeAcademica>
  + TelaEscolherUA(acesso: IAcessoApi)
  + aoExibir(): void
  + aoEscolherUA(unidade: UnidadeAcademica): void
  + aoVoltar(): void
  + aoMudarEstado(estado: EstadoTela): void
}

class TelaQuestionario {
  - unidade: UnidadeAcademica
  - acesso: IAcessoApi
  - rascunho: RascunhoAvaliacao
  - controlador: IControladorTelaRemota<DimensaoQualidade>
  - servicoEnvio: ServicoEnvioAvaliacao
  - dimensaoAtual: Integer
  + TelaQuestionario(unidade: UnidadeAcademica, acesso: IAcessoApi)
  + aoExibir(): void
  + aoDarNota(questao: Questao, valor: Integer): void
  + aoAvancarDimensao(): void
  + aoVoltarDimensao(): void
  + aoEnviar(): void
  + aoVoltar(): void
  + aoMudarEstado(estado: EstadoTela): void
  - mostrarDimensao(): void
  - marcarPendentes(pendentes: List<Questao>): void
  - mostrarFalhaNoEnvio(): void
}

class TelaConfirmacao {
  + TelaConfirmacao()
  + aoExibir(): void
  + aoConcluir(): void
}

class RascunhoAvaliacao {
  - unidade: UnidadeAcademica
  - notas: Map<Integer, Integer>
  + RascunhoAvaliacao(unidade: UnidadeAcademica)
  + definirNota(questao: Questao, valor: Integer): void
  + obterNota(questao: Questao): Integer
  + questoesPendentes(dimensoes: List<DimensaoQualidade>): List<Questao>
  + estaCompleto(dimensoes: List<DimensaoQualidade>): Boolean
  + montarAvaliacao(): Avaliacao
}

IControlador <|.. Controlador
IObservadorEstado <|.. TelaEscolherUA
IObservadorEstado <|.. TelaQuestionario

TelaAvaliacao --> "1" IAcessoApi : acesso
TelaAvaliacao ..> TelaEscolherUA : <<create>>
TelaAvaliacao ..> TelaConsulta : <<use>>

TelaEscolherUA --> "1" IAcessoApi : acesso
TelaEscolherUA --> "1" IControlador : controlador
TelaEscolherUA ..> Controlador : <<create>>
TelaEscolherUA ..> FonteUnidades : <<create>>
TelaEscolherUA ..> TelaQuestionario : <<create>>
TelaEscolherUA ..> UnidadeAcademica : <<use>>

TelaQuestionario --> "1" UnidadeAcademica : unidade
TelaQuestionario --> "1" IAcessoApi : acesso
TelaQuestionario --> "1" RascunhoAvaliacao : rascunho
TelaQuestionario --> "1" IControlador : controlador
TelaQuestionario --> "1" ServicoEnvioAvaliacao : servicoEnvio
TelaQuestionario ..> Controlador : <<create>>
TelaQuestionario ..> RascunhoAvaliacao : <<create>>
TelaQuestionario ..> FonteQuestionario : <<create>>
TelaQuestionario ..> ServicoEnvioAvaliacao : <<create>>
TelaQuestionario ..> TelaConfirmacao : <<create>>
TelaQuestionario ..> DimensaoQualidade : <<use>>
TelaQuestionario ..> Questao : <<use>>
TelaQuestionario ..> ResultadoEnvio : <<use>>

RascunhoAvaliacao --> "1" UnidadeAcademica : unidade
RascunhoAvaliacao ..> Avaliacao : <<create>>
RascunhoAvaliacao ..> DimensaoQualidade : <<use>>
RascunhoAvaliacao ..> Questao : <<use>>
@enduml
