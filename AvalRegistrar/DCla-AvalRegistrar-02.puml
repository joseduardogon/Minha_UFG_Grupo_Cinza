@startuml DCla-AvalRegistrar-02
title DCla-AvalRegistrar-02 – Classes do componente FonteUnidades
hide empty members

package "Comum" {
  interface "IFonteDados<UnidadeAcademica>" as IFonteDados <<Comum>> {
    + carregar(): List<UnidadeAcademica>
  }
  interface IAcessoApi <<Comum>> {
    + obter(caminho: String, parametros: Map<String, String>): RespostaApi
    + enviar(caminho: String, corpo: String): RespostaApi
  }
  class RespostaApi <<Comum>> {
    + codigoStatus: Integer
    + corpo: String
    + bemSucedida(): Boolean
  }
  class ErroApi <<Comum>> {
    + mensagem: String
  }
  enum TipoErroApi <<Comum>> {
    SEM_CONEXAO
    TEMPO_ESGOTADO
    ERRO_SERVIDOR
    RESPOSTA_INVALIDA
  }
}

package "Locais" {
  class Local <<Locais>> {
    + id: Integer
    + nome: String
  }
  class UnidadeAcademica <<Locais>> {
    + sigla: String
  }
}

class FonteUnidades {
  - acesso: IAcessoApi
  + FonteUnidades(acesso: IAcessoApi)
  + carregar(): List<UnidadeAcademica>
  - converter(corpo: String): List<UnidadeAcademica>
}

IFonteDados <|.. FonteUnidades
FonteUnidades --> "1" IAcessoApi : acesso
FonteUnidades ..> UnidadeAcademica : <<create>>
FonteUnidades ..> ErroApi : <<throws>>
IAcessoApi ..> RespostaApi
IAcessoApi ..> ErroApi : <<throws>>
ErroApi --> "1" TipoErroApi : tipo
Local <|-- UnidadeAcademica
@enduml
