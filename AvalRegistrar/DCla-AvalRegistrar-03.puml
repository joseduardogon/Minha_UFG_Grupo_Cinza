@startuml DCla-AvalRegistrar-03
title DCla-AvalRegistrar-03 – Classes do componente FonteQuestionario
hide empty members

package "Comum" {
  interface "IFonteDados<DimensaoQualidade>" as IFonteDados <<Comum>> {
    + carregar(): List<DimensaoQualidade>
  }
  interface IAcessoApi <<Comum>> {
    + obter(caminho: String, parametros: Map<String, String>): RespostaApi
    + enviar(caminho: String, corpo: String): RespostaApi
  }
  class RespostaApi <<Comum>> {
    + codigoStatus: Integer
    + corpo: String
    + bemSucedida(): Boolean
  }
  class ErroApi <<Comum>> {
    + mensagem: String
  }
  enum TipoErroApi <<Comum>> {
    SEM_CONEXAO
    TEMPO_ESGOTADO
    ERRO_SERVIDOR
    RESPOSTA_INVALIDA
  }
}

class FonteQuestionario {
  + FonteQuestionario(acesso: IAcessoApi)
  + carregar(): List<DimensaoQualidade>
  - converter(corpo: String): List<DimensaoQualidade>
}

class DimensaoQualidade {
  + id: Integer
  + nome: String
  + ordem: Integer
  + elementos: List<ElementoEducacional>
}

class ElementoEducacional {
  + id: Integer
  + nome: String
  + ordem: Integer
  + questoes: List<Questao>
}

class Questao {
  + id: Integer
  + texto: String
  + ordem: Integer
}

note right of Questao
  As três entidades são lidas
  também por AvalConsultar
  (DD-AvalRegistrar-01).
end note

IFonteDados <|.. FonteQuestionario
FonteQuestionario --> "1" IAcessoApi : acesso
FonteQuestionario ..> DimensaoQualidade : <<create>>
FonteQuestionario ..> ErroApi : <<throws>>
IAcessoApi ..> RespostaApi
IAcessoApi ..> ErroApi : <<throws>>
ErroApi --> "1" TipoErroApi : tipo
DimensaoQualidade "1" -- "1..*" ElementoEducacional : é caracterizada por >
ElementoEducacional "1" -- "1..*" Questao : tem >
@enduml
