@startuml DCmp-AvalRegistrar-01
title DCmp-AvalRegistrar-01 – Componentes do pacote AvalRegistrar
skinparam componentStyle uml2
skinparam nodesep 40
skinparam ranksep 90
left to right direction

package "AvalRegistrar" {
  component "TelasAvaliacao" as Telas
  component "FonteUnidades" as FonteUA
  component "FonteQuestionario" as FonteQ
  component "ServicoEnvioAvaliacao" as Servico
}

package "Interfaces do pacote Comum" {
  rectangle "<<interface>>\nIObservadorEstado" as IObservador
  rectangle "<<interface>>\nIControladorTelaRemota" as IControlador
  rectangle "<<interface>>\nIFonteDados" as IFonteDados
  rectangle "<<interface>>\nIAcessoApi" as IAcessoApi
}

package "Locais (pacote de Maicon)" {
  rectangle "<<entidade>>\nUnidadeAcademica" as UA
}

package "AvalConsultar (pacote de Phablo)" {
  rectangle "Tela de AvalConsultar" as Consulta
}

Telas ..|> IObservador : oferece
FonteUA ..|> IFonteDados : oferece\n(UnidadeAcademica)
FonteQ ..|> IFonteDados : oferece\n(DimensaoQualidade)

Telas ..> IControlador : requer
Telas ..> IAcessoApi : requer
FonteUA ..> IAcessoApi : requer
FonteQ ..> IAcessoApi : requer
Servico ..> IAcessoApi : requer

Telas ..> FonteUA : cria
Telas ..> FonteQ : cria
Telas ..> Servico : cria

Telas ..> UA : usa
FonteUA ..> UA : cria
Servico ..> UA : usa
Telas ..> Consulta : abre\n("Ver notas")
@enduml
