@startuml DSeq-AvalRegistrar-02
title DSeq-AvalRegistrar-02 – Sequência de E1: escolher a UA e carregar o questionário
actor "Avaliador" as M
participant ":TelaEscolherUA" as TE
participant ":TelaQuestionario" as T
participant ":RascunhoAvaliacao" as R
participant ":ServicoEnvioAvaliacao" as V
participant ":ControladorTelaRemota<DimensaoQualidade>" as K
participant ":FonteQuestionario" as F
participant ":ClienteApi" as A
participant "Servidor/API" as S <<sistema>>

M -> TE : aoEscolherUA(unidade)
create T
TE -> T : TelaQuestionario(unidade, acesso)
TE -> T : aoExibir()
create R
T -> R : RascunhoAvaliacao(unidade)
create F
T -> F : FonteQuestionario(acesso)
create K
T -> K : ControladorTelaRemota<DimensaoQualidade>(fonte)
create V
T -> V : ServicoEnvioAvaliacao(acesso)
T -> K : registrarObservador(this)
T -> T : dimensaoAtual = 0
T -> K : aoEntrarNaTela()
ref over T, K, F, A, S
  Carregar e exibir (DSeq-AvalRegistrar-01)
  Neste uso: fonte = FonteQuestionario, chamada = obter("/avaliacao/questionario", {}),
  dados = List<DimensaoQualidade>; o que a tela mostra em cada desfecho está abaixo.
end ref
alt questionário com dimensões (EXIBINDO)
  T -> K : obterDados()
  K --> T : List<DimensaoQualidade>
  T -> T : mostrarDimensao()
  T -> M : mostra a 1ª dimensão, com elementos e questões sem nota
else questionário vazio (VAZIO)
  T -> M : mostra a mensagem de vazio
else falha de comunicação (INDISPONIVEL)
  T -> M : mostra a mensagem de indisponibilidade
end
@enduml
