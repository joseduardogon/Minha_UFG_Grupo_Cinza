@startuml DSeq-AvalRegistrar-05
title DSeq-AvalRegistrar-05 – Sequência de E4: enviar a avaliação
actor "Avaliador" as M
participant ":TelaQuestionario" as T
participant ":TelaConfirmacao" as C
participant ":RascunhoAvaliacao" as R
participant ":ControladorTelaRemota<DimensaoQualidade>" as K
participant ":ServicoEnvioAvaliacao" as V
participant ":ClienteApi" as A
participant "Servidor/API" as S <<sistema>>

M -> T : aoEnviar()
T -> K : obterDados()
K --> T : List<DimensaoQualidade>
T -> R : estaCompleto(dimensoes)
R --> T : Boolean
alt há questão sem nota (estaCompleto = falso)
  T -> R : questoesPendentes(dimensoes)
  R --> T : List<Questao>
  T -> T : marcarPendentes(pendentes)
  T -> M : marca as questões sem nota
  note over T, S : nada é enviado; sem chamada à API
else todas as questões têm nota (estaCompleto = verdadeiro)
  T -> R : montarAvaliacao()
  R --> T : Avaliacao
  T -> M : indica que está enviando
  T -> V : enviar(avaliacao)
  V -> V : serializar(avaliacao)
  V -> A : enviar("/avaliacoes", corpo)
  A -> S : POST UA e notas (sem dados do avaliador)
  alt resposta bem-sucedida
    S --> A : 2xx
    A --> V : RespostaApi
    V -> V : resposta.bemSucedida()
    V --> T : REGISTRADA
    create C
    T -> C : TelaConfirmacao()
    T -> C : aoExibir()
    C -> M : mostra "Avaliação registrada. Obrigado por contribuir!"
  else falha de comunicação ou resposta sem sucesso
    A --> V : ErroApi (ou RespostaApi com bemSucedida() falso)
    V --> T : NAO_REGISTRADA
    T -> T : mostrarFalhaNoEnvio()
    T -> M : avisa que a avaliação não foi registrada; as notas continuam na tela
  end
end
@enduml
