@startuml DCla-Comum-02
title DCla-Comum-02 – Classes do componente AcessoApi
hide empty members

interface IAcessoApi {
  + obter(caminho: String, parametros: Map<String, String>): RespostaApi
  + enviar(caminho: String, corpo: String): RespostaApi
}

class ClienteApi {
  - urlBase: String
  - tempoLimiteMs: Integer = 15000
  + obter(caminho: String, parametros: Map<String, String>): RespostaApi
  + enviar(caminho: String, corpo: String): RespostaApi
  - haConexao(): Boolean
  - montarUrl(caminho: String, parametros: Map<String, String>): String
}

class RespostaApi {
  + codigoStatus: Integer
  + corpo: String
  + bemSucedida(): Boolean
}

class ErroApi {
  + mensagem: String
}

enum TipoErroApi {
  SEM_CONEXAO
  TEMPO_ESGOTADO
  ERRO_SERVIDOR
  RESPOSTA_INVALIDA
}

IAcessoApi <|.. ClienteApi
ClienteApi ..> RespostaApi : <<create>>
ClienteApi ..> ErroApi : <<throws>>
ErroApi --> "1" TipoErroApi : tipo
@enduml
