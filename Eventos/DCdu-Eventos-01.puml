@startuml DCdu-Eventos-01
title DCdu-Eventos-01 – Casos de uso da funcionalidade Eventos
left to right direction
skinparam packageStyle rectangle

actor "Membro da comunidade UFG" as Membro
actor "Servidor/API" as API <<sistema>>
actor "Aplicativo externo" as AppExt <<sistema>>
actor "Navegador" as Nav <<sistema>>
Nav -up-|> AppExt

rectangle "App Minha UFG – Eventos" {
  usecase "UC04.1\nConsultar eventos por\nregional e data" as UC041
  usecase "UC04.2\nTrocar o mês\ndo calendário" as UC042
  usecase "UC04.3\nAbrir a página\ndo evento" as UC043
}

Membro --> UC041
UC042 .> UC041 : <<extend>>
UC043 .> UC041 : <<extend>>
UC041 --> API
UC042 --> API
UC043 --> Nav
@enduml
