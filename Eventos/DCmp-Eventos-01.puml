@startuml DCmp-Eventos-01
title DCmp-Eventos-01 – Componentes do pacote Eventos
skinparam componentStyle uml2
skinparam nodesep 25
skinparam ranksep 110
left to right direction

package "Eventos" {
  component "TelaEventos" as Tela
  component "FonteEventos" as Fonte
  rectangle "<<interface>>\nIFiltroEventos" as IFiltro
}

package "Interfaces do pacote Comum" {
  rectangle "<<interface>>\nIControladorTelaRemota" as IControlador
  rectangle "<<interface>>\nILinkExterno" as ILinkExterno
  rectangle "<<interface>>\nIFonteDados" as IFonteDados
  rectangle "<<interface>>\nIObservadorEstado" as IObservador
  rectangle "<<interface>>\nIAcessoApi" as IAcessoApi
}

Tela ..|> IFiltro : oferece
Tela ..|> IObservador : oferece
Fonte ..|> IFonteDados : oferece

Tela ..> IControlador : requer
Tela ..> IFonteDados : requer
Tela ..> ILinkExterno : requer
Tela ..> IAcessoApi : requer
Fonte ..> IAcessoApi : requer
Fonte ..> IFiltro : requer
@enduml
