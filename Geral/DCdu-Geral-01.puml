@startuml DCdu-Geral-01
title DCdu-Geral-01 – Casos de uso gerais do app Minha UFG
left to right direction
skinparam packageStyle rectangle

actor "Membro da comunidade UFG" as Membro
actor "Avaliador" as Avaliador
Avaliador -up-|> Membro

actor "Servidor/API" as API <<sistema>>
actor "Provedor de mapa / GPS" as Mapa <<sistema>>
actor "Aplicativo externo" as AppExt <<sistema>>
actor "Play Store" as PlayStore <<sistema>>
actor "Navegador" as Navegador <<sistema>>
actor "Visualizador de PDF" as VisPDF <<sistema>>
PlayStore -up-|> AppExt
Navegador -up-|> AppExt
VisPDF -up-|> AppExt

rectangle "App Minha UFG" {
  usecase "UC01\nSolicitar apoio\nde segurança" as UC01
  usecase "UC02\nConsultar programação\nda rádio" as UC02
  usecase "UC03\nConsultar guia\nestudantil" as UC03
  usecase "UC04\nConsultar eventos" as UC04
  usecase "UC05\nConsultar notícias" as UC05
  usecase "UC06\nConsultar cardápio\ndo RU" as UC06
  usecase "UC07\nLocalizar locais" as UC07
  usecase "UC08\nConsultar apps UFG" as UC08
  usecase "UC09\nAvaliar UA" as UC09
  usecase "UC10\nConsultar notas\nde avaliação" as UC10
}

Membro --> UC01
Membro --> UC02
Membro --> UC03
Membro --> UC04
Membro --> UC05
Membro --> UC06
Membro --> UC07
Membro --> UC08
Membro --> UC10
Avaliador --> UC09

UC01 --> Navegador
UC01 --> PlayStore
UC02 --> API
UC02 --> Navegador
UC03 --> VisPDF
UC04 --> API
UC04 --> Navegador
UC05 --> API
UC05 --> Navegador
UC06 --> API
UC07 --> API
UC07 --> Mapa
UC08 --> PlayStore
UC09 --> API
UC10 --> API
@enduml
