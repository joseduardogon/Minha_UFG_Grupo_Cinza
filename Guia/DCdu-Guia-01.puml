left to right direction
skinparam packageStyle rectangle

actor "Membro da comunidade UFG" as Membro
actor "Aplicativo externo" as AppExt <<sistema>>
actor "Visualizador de PDF" as VisPDF <<sistema>>
VisPDF -up-|> AppExt

rectangle "App Minha UFG – Guia Estudantil" {
  usecase "UC03.1\nConsultar guia\nestudantil" as UC031
}

Membro --> UC031
UC031 --> VisPDF
@enduml
