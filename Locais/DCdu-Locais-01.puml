@startuml DCdu-Locais-01
title DCdu-Locais-01 – Casos de uso de Locais
left to right direction
skinparam packageStyle rectangle

actor "Membro da comunidade UFG" as Membro
actor "Servidor/API" as API <<sistema>>
actor "Provedor de mapa / GPS" as Mapa <<sistema>>

rectangle "App Minha UFG – Locais" {
  usecase "UC07.1\nConsultar lista\nde locais" as UC071
  usecase "UC07.2\nVisualizar local\nno mapa" as UC072
  usecase "UC07.3\nCentralizar em minha\nlocalização atual" as UC073
}

Membro --> UC071
Membro --> UC072
Membro --> UC073

UC071 --> API
UC072 --> Mapa
UC073 --> Mapa
@enduml
