@startuml DCdu-Noticias-01
title DCdu-Noticias-01 – Casos de uso da funcionalidade Notícias
left to right direction
skinparam packageStyle rectangle

actor "Membro da comunidade UFG" as Membro
actor "Servidor/API" as API <<sistema>>
actor "Aplicativo externo" as AppExt <<sistema>>
actor "Navegador" as Nav <<sistema>>
Nav -up-|> AppExt

rectangle "App Minha UFG – Notícias" {
  usecase "UC05.1\nConsultar notícias\nde uma regional" as UC051
  usecase "UC05.2\nAbrir a notícia" as UC052
}

Membro --> UC051
UC052 .> UC051 : <<extend>>
UC051 --> API
UC052 --> Nav
@enduml
