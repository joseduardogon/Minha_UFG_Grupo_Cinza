@startuml DCla-Noticias-02
title DCla-Noticias-02 – Classes do componente FonteNoticias
hide empty members

package "Comum" {
  interface "IFonteDados<Noticia>" as IFonteDados <<Comum>> {
    + carregar(): List<Noticia>
  }
  interface IAcessoApi <<Comum>> {
    + obter(caminho: String, parametros: Map<String, String>): RespostaApi
  }
  class Regional <<Comum (proposta)>>
}

interface IFiltroNoticias <<DCla-Noticias-01>> {
  + obterRegionalSelecionada(): Regional
}

class FonteNoticias {
  - acesso: IAcessoApi
  - filtro: IFiltroNoticias
  + FonteNoticias(acesso: IAcessoApi, filtro: IFiltroNoticias)
  + carregar(): List<Noticia>
  - montarParametros(): Map<String, String>
  - converter(corpo: String): List<Noticia>
}

class Noticia {
  + id: Integer
  + titulo: String
  + resumo: String
  + urlImagem: String
  + url: String
  + idRegional: Integer
}

IFonteDados <|.. FonteNoticias
FonteNoticias --> "1" IAcessoApi : acesso
FonteNoticias --> "1" IFiltroNoticias : filtro
FonteNoticias ..> Noticia : <<create>>
Noticia "0..*" --> "1" Regional : regional
@enduml
