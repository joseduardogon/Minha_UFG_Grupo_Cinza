@startuml DCdu-Seguranca-01
title DCdu-Seguranca-01 – Casos de uso de Segurança
left to right direction
skinparam packageStyle rectangle

actor "Membro da comunidade UFG" as Membro
actor "Aplicativo externo" as AppExt <<sistema>>
actor "Navegador" as Navegador <<sistema>>
actor "Play Store" as PlayStore <<sistema>>
Navegador -up-|> AppExt
PlayStore -up-|> AppExt

rectangle "App Minha UFG – Segurança" {
  usecase "UC01.1\nAcessar central de\nsegurança via web" as UC011
  usecase "UC01.2\nBaixar aplicativo de\nsegurança na Play Store" as UC012
}

Membro --> UC011
Membro --> UC012

UC011 --> Navegador
UC012 --> PlayStore
@enduml

